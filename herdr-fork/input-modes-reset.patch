+    // AgentNav
+    #[test]
+    fn agentnav_reset_abandoned_input_modes_stops_mouse_focus_and_keyboard_reports() {
+        let (tx, _rx) = mpsc::channel(4);
+        let terminal = crate::ghostty::Terminal::new(80, 24, 0).unwrap();
+        let pane = GhosttyPaneTerminal::new(terminal, tx).unwrap();
+        let (fresh_tx, _fresh_rx) = mpsc::channel(4);
+        let fresh_terminal = crate::ghostty::Terminal::new(80, 24, 0).unwrap();
+        let fresh = GhosttyPaneTerminal::new(fresh_terminal, fresh_tx).unwrap();
+        let moved = |pane: &GhosttyPaneTerminal| {
+            pane.encode_mouse_motion(
+                crossterm::event::MouseEventKind::Moved,
+                crate::input::mouse::Position::Cell { column: 4, row: 6 },
+                crossterm::event::KeyModifiers::empty(),
+            )
+        };
+        let key = crate::input::parse_terminal_key_sequence("\x1b[27u").unwrap();
+
+        // What Claude Code leaves behind when it is killed.
+        pane.seed_history_ansi("\x1b[?1003h\x1b[?1006h\x1b[?1004h\x1b[>1u\x1b[>4;2m");
+        assert!(pane.mouse_reporting_enabled());
+        assert!(pane.focus_reporting_enabled());
+        assert!(moved(&pane).is_some());
+
+        assert_eq!(pane.reset_abandoned_input_modes(), (true, true));
+
+        assert!(!pane.mouse_reporting_enabled());
+        assert!(!pane.focus_reporting_enabled());
+        assert_eq!(moved(&pane), moved(&fresh));
+        #[cfg(windows)]
+        {
+            assert_eq!(pane.modify_other_keys_level(), 0);
+            assert_eq!(
+                pane.encode_terminal_key(key.clone()),
+                fresh.encode_terminal_key(key.clone())
+            );
+        }
+        let _ = key;
+        assert_eq!(fresh.reset_abandoned_input_modes(), (false, false));
+    }
