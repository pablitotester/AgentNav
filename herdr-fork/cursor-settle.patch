# Propuesta (NO aplicada) para el fork pablitotester/herdr, rama agentnav, sobre v0.9.5:
# retención del cursor en Windows configurable desde [advanced].
#
#   [advanced]
#   cursor_settle_ms = 20       # paso normal del cursor (misma fila, hasta 2 columnas); 0 = sin retención
#   cursor_jump_hold_ms = 100   # "salto" (otra fila o más de 2 columnas); 0 = sin retención
#
# Con los defaults el comportamiento es idéntico al de v0.9.5. Se lee una vez al arrancar el servidor (OnceLock);
# reload-config no lo cambia. Los hunks de cursor.rs, terminal.rs, model.rs y main.rs son contra v0.9.5 tal cual;
# el enganche en App::new (src/app/mod.rs) va descripto al final porque su contexto exacto depende del rebase.
# Ver herdr-fork\cursor-lag.md para el análisis.

--- a/src/pane/cursor.rs
