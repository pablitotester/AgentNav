+    /// AgentNav: an agent that is killed (instead of exiting) never turns off the input modes it
+    /// asked for, and the shell that gets the pane back does not either: every mouse move, focus
+    /// change and CSI-u key would be typed into its prompt. Called when the pane falls back from an
+    /// agent to its shell. Returns whether mouse and focus reporting were still on.
+    pub fn reset_abandoned_input_modes(&self) -> (bool, bool) {
+        let Ok(mut core) = self.core.lock() else {
+            return (false, false);
+        };
+        let mouse = core.terminal.mouse_tracking_enabled().unwrap_or(false);
+        let focus = core
+            .terminal
+            .mode_get(crate::ghostty::MODE_FOCUS_EVENT)
+            .unwrap_or(false);
+        let mut ansi: Vec<u8> = Vec::new();
+        ansi.extend_from_slice(
+            b"\x1b[?9l\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1005l\x1b[?1006l\x1b[?1015l\x1b[?1016l\x1b[?1004l",
+        );
+        // Windows shells (PowerShell, cmd) never negotiate a keyboard protocol; elsewhere a shell
+        // such as fish may already have pushed its own by now, so it is left alone.
+        if cfg!(windows) {
+            ansi.extend_from_slice(b"\x1b[<99u\x1b[=0u\x1b[>4;0m");
+        }
+        core.kitty_keyboard.observe(&ansi);
+        core.terminal.write(&ansi);
+        if let Ok(mut key_encoder) = self.key_encoder.lock() {
+            configure_key_encoder(&mut key_encoder, &core.terminal);
+        }
+        (mouse, focus)
+    }
